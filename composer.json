{
    "name": "tinymvc/tinypdf",
    "description": "Fast, dependency-free Modern HTML to PDF generator for PHP 8.2+",
    "type": "library",
    "keywords": [
        "pdf",
        "html-to-pdf",
        "bangla",
        "bengali",
        "indic",
        "flexbox",
        "svg",
        "zero-dependency",
        "pure-php"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "Spark\\Pdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php"
    },
    "authors": [
        {
            "name": "Shahin Moyshan",
            "email": "shahin.moyshan2@gmail.com"
        }
    ]
}