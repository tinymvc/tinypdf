{
    "name": "tinymvc/tinypdf",
    "description": "Minimal HTML to PDF for PHP 8.2+ with accurate native multilingual typography",
    "type": "library",
    "keywords": [
        "pdf",
        "html-to-pdf",
        "bangla",
        "bengali",
        "indic",
        "flexbox",
        "svg",
        "unicode",
        "harfbuzz",
        "multilingual"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "ext-ctype": "*",
        "ext-json": "*"
    },
    "suggest": {
        "ext-gd": "Required for PNG, GIF and WebP images"
    },
    "autoload": {
        "psr-4": {
            "Spark\\Pdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/tinypdf-install.php"
        ],
        "post-update-cmd": [
            "@php bin/tinypdf-install.php"
        ],
        "test": "@php tests/run.php"
    },
    "authors": [
        {
            "name": "Shahin Moyshan",
            "email": "shahin.moyshan2@gmail.com"
        }
    ],
    "bin": [
        "bin/tinypdf-install.php",
        "bin/tinypdf-check.php",
        "bin/install-fonts.php"
    ],
    "extra": {
        "tinypdf": {
            "version": "1.2.2",
            "text-protocol": 1
        }
    }
}
